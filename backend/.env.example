# Copy to .env for local backend configuration. No secrets are needed for SQLite.
NEXORA_HOST=127.0.0.1
NEXORA_PORT=8000
NEXORA_SESSION_DAYS=7
NEXORA_SECURE_COOKIES=false
NEXORA_FRONTEND_ORIGIN=http://localhost:5173
NEXORA_COOKIE_SAMESITE=Strict
# Optional: NEXORA_DATABASE=data/nexora.sqlite3 (relative to the launch directory)
# Optional for PostgreSQL: NEXORA_DATABASE_URL=postgresql://...
